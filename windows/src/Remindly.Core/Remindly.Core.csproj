<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pure logic + storage + update checks. Cross-platform TFM so the unit tests run on any OS. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Remindly.Core</RootNamespace>
    <AssemblyName>Remindly.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Remindly.Core.Tests" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Firebase client configuration is injected from the existing GitHub Actions secret.
       It is not committed to the repository. Local builds work without it, with sync disabled. -->
  <ItemGroup Condition="Exists('../../../app/google-services.json')">
    <EmbeddedResource Include="../../../app/google-services.json" LogicalName="google-services.json" />
  </ItemGroup>

</Project>
