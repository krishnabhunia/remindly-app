<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for NotifyIcon (notification-area icon + balloon tips). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Remindly.App</RootNamespace>
    <AssemblyName>Remindly</AssemblyName>
    <AssemblyTitle>Remindly</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Remindly.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!-- Builds on Windows and cross-compiles from Linux/macOS. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>

    <!-- One portable EXE; nothing to install for the portable copy. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <!-- Keep the WPF names (Application, MessageBox, Clipboard…) unambiguous: WinForms is referenced explicitly where used. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remindly.Core\Remindly.Core.csproj" />
  </ItemGroup>

  <!-- Program.Main is the entry point (single instance, the exit and smoke-test switches), so App.xaml must not
       generate a second Main: compile it as a plain page; Program calls InitializeComponent itself. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
    <!-- Design fonts (SIL Open Font License 1.1, licence texts beside them): Manrope (B), IBM Plex (C), Plus Jakarta Sans (D). -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\OFL-*.txt" />
  </ItemGroup>

</Project>
