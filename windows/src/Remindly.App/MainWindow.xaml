<Window x:Class="Remindly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remindly" Width="1200" Height="780" MinWidth="1040" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource SurfaceBrush}" Icon="Assets/app.ico">
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#F5F6F7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="ModePicker" Width="132" Margin="0,0,18,0" SelectionChanged="ModePicker_SelectionChanged" AutomationProperties.Name="App mode">
                            <ComboBoxItem Content="Task mode"/><ComboBoxItem Content="Shop mode"/>
                        </ComboBox>
                        <TextBlock Text="Remindly" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,18,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
                    <Border x:Name="UpdateBanner" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateBannerText" Visibility="Collapsed" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}" Margin="0,0,8,0"/>
                            <Button x:Name="UpdateBannerButton" Content="Update" Click="UpdateBannerButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="#F5F6F7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,8">
                <TextBlock x:Name="FooterText" Text="Reminders stay active while Remindly runs in the notification area" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
            </Border>
            <Border DockPanel.Dock="Left" Width="170" Background="#F5F6F7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10,24,10,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkSubtleBrush}" Margin="12,0,0,16"/>
                    <TabControl x:Name="NavTabs" BorderThickness="0" Background="Transparent" SelectionChanged="NavTabs_SelectionChanged">
                        <TabControl.Template><ControlTemplate TargetType="TabControl"><ItemsPresenter/></ControlTemplate></TabControl.Template>
                        <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></TabControl.ItemsPanel>
                        <TabItem x:Name="OverviewTab" Header="Overview" Style="{StaticResource NavTab}"/>
                        <TabItem x:Name="TasksTab" Header="Tasks" Style="{StaticResource NavTab}"/>
                        <TabItem x:Name="RemindersTab" Header="Reminders" Style="{StaticResource NavTab}"/>
                        <TabItem x:Name="LearnTab" Header="Learn" Style="{StaticResource NavTab}"/>
                        <TabItem x:Name="CallsTab" Header="Calls" Style="{StaticResource NavTab}"/>
                        <TabItem x:Name="BuyTab" Header="Buy" Style="{StaticResource NavTab}"/>
                        <TabItem x:Name="ShopsTab" Header="Shops" Style="{StaticResource NavTab}"/>
                        <TabItem x:Name="ProductsTab" Header="Products" Style="{StaticResource NavTab}"/>
                        <TabItem x:Name="SettingsTab" Header="Settings" Style="{StaticResource NavTab}"/>
                    </TabControl>
                </DockPanel>
            </Border>
            <ContentControl x:Name="Page" Margin="28,24,24,18" Focusable="False"/>
        </DockPanel>

        <!-- Snackbar: "Moved to Done" + Undo -->
        <Border x:Name="SnackBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="#2D2D3A" CornerRadius="10" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SnackText" Foreground="White" VerticalAlignment="Center" FontSize="14" MaxWidth="560" TextWrapping="Wrap" />
                <Button x:Name="SnackUndo" Content="UNDO" Margin="16,0,0,0" Background="Transparent" BorderBrush="Transparent"
                        Foreground="#9FE8CF" FontWeight="Bold" Click="SnackUndo_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
