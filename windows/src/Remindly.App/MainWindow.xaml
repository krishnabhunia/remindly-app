<Window x:Class="Remindly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remindly" Width="1180" Height="800" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontSize="14" Icon="Assets/app.ico">
    <Grid>
        <!-- The navigation model. It is never drawn: each design (Views/Shells.cs) draws its own menu and drives these tabs,
             so Go(), the tray, reminders and the smoke test work the same in every design. -->
        <TabControl x:Name="NavTabs" Visibility="Collapsed" SelectionChanged="NavTabs_SelectionChanged">
            <TabItem x:Name="TodayTab" Header="Today" />
            <TabItem x:Name="TasksTab" Header="Tasks" />
            <TabItem x:Name="LearnTab" Header="Learn" />
            <TabItem x:Name="CallsTab" Header="Calls" />
            <TabItem x:Name="OverviewTab" Header="Overview" />
            <TabItem x:Name="BuyTab" Header="Buy" />
            <TabItem x:Name="ShopsTab" Header="Shops" />
            <TabItem x:Name="ProductsTab" Header="Products" />
            <TabItem x:Name="SettingsTab" Header="Settings" />
        </TabControl>

        <!-- The current design's shell: menu, mode switch, version, the top-right update button and the page. -->
        <ContentControl x:Name="ShellHost" Focusable="False" />

        <!-- Snackbar: "Moved to Done" + Undo -->
        <Border x:Name="SnackBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="#2D2D3A" CornerRadius="10" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SnackText" Foreground="White" VerticalAlignment="Center" FontSize="14" MaxWidth="560" TextWrapping="Wrap" />
                <Button x:Name="SnackUndo" Content="UNDO" Margin="16,0,0,0" Background="Transparent" BorderBrush="Transparent"
                        Foreground="#9FE8CF" FontWeight="Bold" Click="SnackUndo_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
