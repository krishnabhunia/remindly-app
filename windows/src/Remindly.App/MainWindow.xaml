<Window x:Class="Remindly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remindly" Width="1120" Height="780" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource SurfaceBrush}" Icon="Assets/app.ico">
    <Grid>
        <DockPanel>
            <!-- Header: name, VERSION (always visible on the home window), update banner, mode switch -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="18,10,18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/app-256.png" Width="38" Height="38" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Remindly" FontSize="21" FontWeight="Bold" Foreground="White" />
                            <TextBlock x:Name="VersionText" Text="Version" FontSize="12.5" Foreground="#EEFFFFFF" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="TaskModeButton" GroupName="mode" Content="☑  Task mode" Style="{StaticResource Chip}" Checked="TaskMode_Checked" />
                        <RadioButton x:Name="ShopModeButton" GroupName="mode" Content="🛒  Shop mode" Style="{StaticResource Chip}" Checked="ShopMode_Checked" />
                    <Border x:Name="UpdateBanner" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#33FFFFFF" CornerRadius="10" Padding="8,4" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateBannerText" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <Button x:Name="UpdateBannerButton" Content="Update now" Click="UpdateBannerButton_Click" />
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                <TabControl x:Name="NavTabs" BorderThickness="0" Background="Transparent" Padding="0" SelectionChanged="NavTabs_SelectionChanged">
                    <TabItem x:Name="TasksTab" Header="Tasks" Style="{StaticResource NavTab}" />
                    <TabItem x:Name="LearnTab" Header="Learn" Style="{StaticResource NavTab}" />
                    <TabItem x:Name="CallsTab" Header="Calls" Style="{StaticResource NavTab}" />
                    <TabItem x:Name="BuyTab" Header="Buy" Style="{StaticResource NavTab}" />
                    <TabItem x:Name="ShopsTab" Header="Shops" Style="{StaticResource NavTab}" />
                    <TabItem x:Name="ProductsTab" Header="Products" Style="{StaticResource NavTab}" />
                    <TabItem x:Name="SettingsTab" Header="Settings" Style="{StaticResource NavTab}" />
                </TabControl>
            </Border>

            <ContentControl x:Name="Page" Margin="22,14,14,10" Focusable="False" />
        </DockPanel>

        <!-- Snackbar: "Moved to Done" + Undo -->
        <Border x:Name="SnackBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="#2D2D3A" CornerRadius="10" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SnackText" Foreground="White" VerticalAlignment="Center" FontSize="14" MaxWidth="560" TextWrapping="Wrap" />
                <Button x:Name="SnackUndo" Content="UNDO" Margin="16,0,0,0" Background="Transparent" BorderBrush="Transparent"
                        Foreground="#9FE8CF" FontWeight="Bold" Click="SnackUndo_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
