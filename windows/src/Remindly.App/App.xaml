<Application x:Class="Remindly.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ── Palette. These are design A's Task-mode values; Services/Theme.cs replaces every key when the
                 design (Settings → Appearance) or the mode changes, so styles read them with DynamicResource. ── -->
            <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECEBFD" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#3B32B8" />
            <SolidColorBrush x:Key="HeaderBrush" Color="#4F46E5" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InkBrush" Color="#1B1B1F" />
            <SolidColorBrush x:Key="InkSubtleBrush" Color="#5A5C66" />
            <SolidColorBrush x:Key="InkHintBrush" Color="#8A8C95" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#EEF0F3" />
            <SolidColorBrush x:Key="LayerBrush" Color="#FBFBFC" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BorderBrush" Color="#E2E4E9" />
            <SolidColorBrush x:Key="NavBrush" Color="#EEF0F3" />
            <SolidColorBrush x:Key="NavSelectedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="ControlInkBrush" Color="#1B1B1F" />
            <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEA" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E6F4EC" />
            <SolidColorBrush x:Key="AmberBrush" Color="#8A5A00" />
            <SolidColorBrush x:Key="AmberSoftBrush" Color="#FFF4DC" />
            <SolidColorBrush x:Key="BlueBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="BlueSoftBrush" Color="#E3EAFC" />
            <SolidColorBrush x:Key="InverseBrush" Color="#1B1B1F" />
            <SolidColorBrush x:Key="InverseInkBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InverseSubBrush" Color="#C9CBD3" />
            <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
            <CornerRadius x:Key="CardRadius">8</CornerRadius>
            <CornerRadius x:Key="ControlRadius">6</CornerRadius>

            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            </Style>
            <Style x:Key="H2" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="GroupHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
                <Setter Property="Margin" Value="4,14,0,6" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!-- Buttons -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Style>
            <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <!-- A flat button with a hover tint: navigation, mode segments, tiles, table rows. -->
            <Style x:Key="Plain" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}" />
                                <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A RadioButton drawn as a chip (Active / Done, sort chips). -->
            <Style x:Key="Chip" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="12,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- The stock ComboBox and DatePicker draw a light box in every design, so their text stays dark. -->
            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="Foreground" Value="{DynamicResource ControlInkBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Foreground" Value="{DynamicResource ControlInkBrush}" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Margin" Value="0,8,0,3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
